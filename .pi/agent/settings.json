{
  "defaultProvider": "qbraid",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "low",
  "defaultProjectTrust": "ask",
  "showCacheMissNotices": true,
  "enableInstallTelemetry": false,
  "theme": "qbraid",
  "compaction": { "enabled": true, "reserveTokens": 16384, "keepRecentTokens": 20000 },
  "retry": { "provider": { "maxRetries": 0 } },
  "packages": [
    "/opt/pi-qbraid",
    "/opt/pi-qbraid/node_modules/pi-subagents",
    { "source": "/opt/pi-qbraid/node_modules/pi-lens", "skills": [] },
    "/opt/pi-qbraid/node_modules/@juicesharp/rpiv-ask-user-question",
    "/opt/pi-qbraid/node_modules/@juicesharp/rpiv-todo"
  ]
}
